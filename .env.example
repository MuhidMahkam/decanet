# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=decanet
DB_USER=root
DB_PASSWORD=
# Used only before login to call GETRUINFO. Assign this account only EXECUTE on GETRUINFO.
DB_LOGIN_USER=replace-with-login-user
DB_LOGIN_PASSWORD=replace-with-login-password
# High-entropy key for database credentials stored in the PHP session.
SESSION_CREDENTIAL_KEY=replace-with-a-random-secret-at-least-32-characters

# Application Configuration
APP_DEBUG=false
APP_ENV=production

# Server Configuration
APP_URL=http://localhost:8000
APP_PORT=8000

# Session Configuration
SESSION_LIFETIME=120

# 2FA Settings
TWO_FA_ENABLED=true
