{
    "name": "muhidmahkam/decanet",
    "description": "PHP/MariaDB project for school management system",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "MuhidMahkam"
        }
    ],
    "require": {
        "php": "^7.4|^8.0",
        "chillerlan/php-qrcode": "^5.0",
        "chillerlan/php-authenticator": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0|^10.0",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "decanet\\": "src/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs --standard=PSR12 src/",
        "lint-fix": "phpcbf --standard=PSR12 src/"
    }
}
